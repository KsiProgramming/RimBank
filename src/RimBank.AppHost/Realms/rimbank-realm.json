{
  "realm": "rimbank",
  "displayName": "RimBank (local development only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "rimbank-api",
      "name": "RimBank API (token audience)",
      "description": "The audience of every access token RimBank.Host accepts. No one signs in to it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "rimbank-dev-client",
      "name": "RimBank development client",
      "description": "Local development only: gets a token for rimbank-api with the client-credentials grant. Its secret is published in this file and must never be used in a deployed environment.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rimbank-dev-client-secret-local-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "rimbank-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rimbank-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "rimbank-mcp-client",
      "name": "RimBank MCP development client",
      "description": "Local development only: lets an MCP client (MCP Inspector, Claude Code) sign rimbank-developer in with the authorization code flow and PKCE, and get a token for rimbank-api. Public client: no secret. Loopback redirects only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost:6274/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "rimbank-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rimbank-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "rimbank-developer",
      "enabled": true,
      "email": "developer@rimbank.invalid",
      "emailVerified": true,
      "firstName": "RimBank",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "rimbank-developer-local-only",
          "temporary": false
        }
      ]
    }
  ]
}

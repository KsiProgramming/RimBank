<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The single deployable host of the modular monolith (specs/tech-stack.md §2). Composition only: it applies the
    service defaults, authenticates every request (ADR 0019), runs the one Wolverine bus (ADR 0017), serves the one MCP
    endpoint (ADR 0021) and registers each context's module (ADR 0014). It holds
    no business logic (§4).
  -->
  <PropertyGroup>
    <RootNamespace>RimBank.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Keycloak.Authentication" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimBank.Postgresql\RimBank.Postgresql.csproj" />
    <ProjectReference Include="..\RimBank.Problems\RimBank.Problems.csproj" />
    <ProjectReference Include="..\RimBank.ServiceDefaults\RimBank.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>

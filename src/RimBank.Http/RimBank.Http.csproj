<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The HTTP conventions every .Api adapter shares (ADR 0018): reading the Idempotency-Key header of a command
    endpoint into the command's IdempotencyKey. It references SharedKernel, RimBank.Problems and ASP.NET Core only,
    holds no business logic, and is used only by .Api adapters and RimBank.Host (specs/tech-stack.md §4).
  -->
  <PropertyGroup>
    <RootNamespace>RimBank.Http</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimBank.SharedKernel\RimBank.SharedKernel.csproj" />
    <ProjectReference Include="..\RimBank.Problems\RimBank.Problems.csproj" />
  </ItemGroup>
</Project>

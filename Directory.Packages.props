<Project>
  <!--
    Central Package Management: every package version lives here, never in a .csproj (ADR 0013).
    - Projects reference packages without a version: <PackageReference Include="Shouldly" />.
    - VersionOverride is disabled, so a project cannot drift from the version set here.
    - Transitive pinning: a PackageVersion here also pins that package when it arrives transitively,
      so a vulnerable transitive dependency is fixed by adding or raising its version here.
    - Packages are grouped by concern and sorted by name. Packages that always move together share a
      version property, so they cannot drift from each other.
    - Adding, replacing or removing a technology requires an ADR (specs/tech-stack.md).
    - Versions are kept current by Dependabot (.github/dependabot.yml); restore is locked in CI.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- Versions shared by packages of the same family. -->
  <PropertyGroup>
    <FsCheckVersion>3.6.0</FsCheckVersion>
    <XunitV3Version>4.0.2</XunitV3Version>
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <MicrosoftExtensionsVersion>10.11.0</MicrosoftExtensionsVersion>
    <!-- Keep equal to the Aspire.AppHost.Sdk version in src/RimBank.AppHost/RimBank.AppHost.csproj. -->
    <AspireVersion>13.6.4</AspireVersion>
  </PropertyGroup>

  <!--
    Local orchestration: .NET Aspire (specs/tech-stack.md §1, ADR 0014).
    Aspire.Hosting.AppHost is an implicit reference of Aspire.AppHost.Sdk, versioned by the SDK; listing it here is NU1009.
  -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
  </ItemGroup>

  <!-- Hosting: service defaults for RimBank.Host (specs/tech-stack.md §1, ADR 0014) -->
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!-- Observability (specs/tech-stack.md §1, mission quality bar) -->
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

  <!-- Testing (specs/tech-stack.md §9, ADR 0007) -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="FsCheck" Version="$(FsCheckVersion)" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="$(FsCheckVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="$(XunitV3Version)" />
  </ItemGroup>

  <!-- Architecture tests (CONTRIBUTING "Architecture rules", ADR 0012) -->
  <ItemGroup Label="Architecture">
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
  </ItemGroup>
</Project>

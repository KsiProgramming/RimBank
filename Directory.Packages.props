<Project>
  <!--
    Central Package Management: every package version lives here, never in a .csproj (ADR 0013).
    - Projects reference packages without a version: <PackageReference Include="Shouldly" />.
    - VersionOverride is disabled, so a project cannot drift from the version set here.
    - Transitive pinning: a PackageVersion here also pins that package when it arrives transitively,
      so a vulnerable transitive dependency is fixed by adding or raising its version here.
    - Packages are grouped by concern and sorted by name. Packages that always move together share a
      version property, so they cannot drift from each other.
    - Adding, replacing or removing a technology requires an ADR (specs/tech-stack.md).
    - Versions are kept current by Dependabot (.github/dependabot.yml); restore is locked in CI.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <!-- Versions shared by packages of the same family. -->
  <PropertyGroup>
    <FsCheckVersion>3.6.0</FsCheckVersion>
    <XunitV3Version>4.0.2</XunitV3Version>
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <WolverineVersion>6.62.0</WolverineVersion>
    <MicrosoftExtensionsVersion>10.11.0</MicrosoftExtensionsVersion>
    <MicrosoftOpenApiVersion>2.13.0</MicrosoftOpenApiVersion>
    <!-- Keep equal to the Aspire.AppHost.Sdk version in src/RimBank.AppHost/RimBank.AppHost.csproj. -->
    <AspireVersion>13.6.4</AspireVersion>
    <!--
      The Keycloak integrations ship only as previews of the same Aspire release (ADR 0019). Keep the release part equal
      to AspireVersion; Dependabot raises both together.
    -->
    <AspireKeycloakVersion>13.6.4-preview.1.26523.11</AspireKeycloakVersion>
  </PropertyGroup>

  <!--
    Local orchestration: .NET Aspire (specs/tech-stack.md §1, ADR 0014).
    Aspire.Hosting.AppHost is an implicit reference of Aspire.AppHost.Sdk, versioned by the SDK; listing it here is NU1009.
  -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="$(AspireKeycloakVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
  </ItemGroup>

  <!--
    Hosting: service defaults and the Keycloak JWT bearer of RimBank.Host (specs/tech-stack.md §1, ADR 0014, ADR 0019),
    and the hosting and health-check abstractions RimBank.Postgresql registers its stores with (ADR 0016).
  -->
  <ItemGroup Label="Hosting">
    <PackageVersion Include="Aspire.Keycloak.Authentication" Version="$(AspireKeycloakVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!--
    HTTP API description: the built-in OpenAPI document and the Scalar UI, mapped by RimBank.ServiceDefaults in
    Development only (specs/tech-stack.md §1, roadmap 1.5).
  -->
  <ItemGroup Label="OpenApi">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
  </ItemGroup>

  <!--
    AI agent interface: the official Model Context Protocol C# SDK, Streamable HTTP at /mcp in RimBank.Host
    (specs/tech-stack.md §1, §6, ADR 0021). It brings ModelContextProtocol and ModelContextProtocol.Core transitively.
  -->
  <ItemGroup Label="Mcp">
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
  </ItemGroup>

  <!--
    Persistence: one Marten store per context, with its own schema, role and async daemon (specs/tech-stack.md §1–§2,
    ADR 0016). Marten brings Npgsql, Weasel and JasperFx; one of them is pinned here only when NuGet audit needs it.
  -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Marten" Version="9.58.0" />
  </ItemGroup>

  <!--
    Messaging: command and query dispatch, the transactional outbox and inbox, and local durable queues
    (specs/tech-stack.md §1–§2, ADR 0017). WolverineFx.Marten must match the Marten version above: 6.62.0 is built
    against Marten 9.58.0. It brings WolverineFx and WolverineFx.Postgresql transitively. WolverineFx.RuntimeCompilation
    (Roslyn) generates the handler code at startup; only RimBank.Host and the tests reference it (ADR 0017).
  -->
  <ItemGroup Label="Messaging">
    <PackageVersion Include="WolverineFx" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.Marten" Version="$(WolverineVersion)" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="$(WolverineVersion)" />
  </ItemGroup>

  <!-- Observability (specs/tech-stack.md §1, mission quality bar) -->
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

  <!-- Testing (specs/tech-stack.md §9, ADR 0007) -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Alba" Version="8.5.3" />
    <PackageVersion Include="FsCheck" Version="$(FsCheckVersion)" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="$(FsCheckVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="$(XunitV3Version)" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="$(XunitV3Version)" />
  </ItemGroup>

  <!--
    BIAN conformance harness: reads the ext-DDD OpenAPI and AsyncAPI specifications (specs/tech-stack.md §9, ADR 0020).
    Microsoft.OpenApi stays on the 2.x line, which Microsoft.AspNetCore.OpenApi for .NET 10 requires ([2.12.2, 3.0.0)),
    so the host can later generate its own OpenAPI document with the same object model. Dependabot ignores its majors.
  -->
  <ItemGroup Label="Conformance">
    <PackageVersion Include="Microsoft.OpenApi" Version="$(MicrosoftOpenApiVersion)" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="$(MicrosoftOpenApiVersion)" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Architecture tests (CONTRIBUTING "Architecture rules", ADR 0012) -->
  <ItemGroup Label="Architecture">
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
  </ItemGroup>
</Project>

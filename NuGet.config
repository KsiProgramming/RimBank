<?xml version="1.0" encoding="utf-8"?>
<!--
  The only package sources RimBank restores from (ADR 0013).
  <clear /> drops machine- and user-level sources, so every machine and CI restore the same way, and
  package source mapping says which source each package may come from (no dependency confusion).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

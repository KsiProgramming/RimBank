<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the BIAN conformance harness (ADR 0020): the loaders on the real PartyReferenceDataDirectory YAML, route
    template matching, and self-tests on a test-only fake context (FakeContexts/) that maps a subset of the Party routes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RimBank.Conformance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimBank.Conformance.Testing\RimBank.Conformance.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Party\RimBank.Party.PartyReferenceDataDirectory.Postgresql\RimBank.Party.PartyReferenceDataDirectory.Postgresql.csproj" />
    <ProjectReference Include="..\..\RimBank.SharedKernel.Testing\RimBank.SharedKernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

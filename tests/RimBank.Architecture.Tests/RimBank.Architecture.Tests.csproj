    <ProjectReference Include="..\..\src\RimBank.Http\RimBank.Http.csproj" />
    <ProjectReference Include="..\..\src\RimBank.Mcp\RimBank.Mcp.csproj" />
    <ProjectReference Include="..\..\src\RimBank.Postgresql\RimBank.Postgresql.csproj" />
    <ProjectReference Include="..\..\src\RimBank.Problems\RimBank.Problems.csproj" />
    <ProjectReference Include="..\..\src\RimBank.ServiceDefaults\RimBank.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\RimBank.SharedKernel\RimBank.SharedKernel.csproj" />
    <ProjectReference Include="..\Party\RimBank.Party.PartyReferenceDataDirectory.Postgresql.Tests\RimBank.Party.PartyReferenceDataDirectory.Postgresql.Tests.csproj" />
    <ProjectReference Include="..\RimBank.AppHost.Tests\RimBank.AppHost.Tests.csproj" />
    <ProjectReference Include="..\RimBank.Architecture.Fixtures\RimBank.Architecture.Fixtures.csproj" />
    <ProjectReference Include="..\RimBank.Conformance.Testing\RimBank.Conformance.Testing.csproj" />

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of RimBank.Mcp (ADR 0022, ADR 0025), in the same folders: the shared MCP conventions at the root (the Error →
    tool result mapping), and one folder per context with its tools called by the SDK's own MCP client through the
    real RimBank.Host against a real PostgreSQL in Testcontainers: tool list, input schemas, results, Problem Details
    errors, authorisation, and parity with the HTTP endpoint of the same operation (specs/tech-stack.md §9, ADR 0039).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RimBank.Mcp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Alba" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimBank.Mcp\RimBank.Mcp.csproj" />
    <ProjectReference Include="..\..\src\RimBank.Host\RimBank.Host.csproj" />
    <ProjectReference Include="..\RimBank.Host.Testing\RimBank.Host.Testing.csproj" />
    <ProjectReference Include="..\RimBank.SharedKernel.Testing\RimBank.SharedKernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of RimBank.Api (ADR 0025), in the same folders: the shared HTTP conventions at the root (the Idempotency-Key
    header and its Problem Details, stream-version entity tags) with an in-memory test server, and one folder per
    context with its request and response mapping, its endpoints over HTTP through the real RimBank.Host (Alba)
    against a real PostgreSQL in Testcontainers, and BIAN conformance of its routes (specs/tech-stack.md §9).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RimBank.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Alba" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimBank.Api\RimBank.Api.csproj" />
    <ProjectReference Include="..\..\src\RimBank.Host\RimBank.Host.csproj" />
    <ProjectReference Include="..\RimBank.Conformance.Testing\RimBank.Conformance.Testing.csproj" />
    <ProjectReference Include="..\RimBank.Host.Testing\RimBank.Host.Testing.csproj" />
    <ProjectReference Include="..\RimBank.SharedKernel.Testing\RimBank.SharedKernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tests of every context's core (no I/O), in the same folders as RimBank.Core (ADR 0023):
    Party/PartyReferenceDataDirectory/Registration/ = namespace RimBank.Party.PartyReferenceDataDirectory.Registration.Tests.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>RimBank.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RimBank.Core\RimBank.Core.csproj" />
    <ProjectReference Include="..\RimBank.SharedKernel.Testing\RimBank.SharedKernel.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
